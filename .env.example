# ==========================================================
#  BLOOD×DIAMONDS — configurare bot
#  Copiază fișierul ăsta în ".env" și completează valorile.
# ==========================================================

# Tokenul botului (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=token_ul_tau_aici

# Application ID / Client ID (Developer Portal -> General Information)
CLIENT_ID=id_ul_aplicatiei

# ID-ul serverului tau (Discord -> Setari -> Avansat -> Mod dezvoltator, apoi
# click dreapta pe server -> Copiaza ID-ul server). Comenzile se inregistreaza
# instant pe serverul asta.
GUILD_ID=id_ul_serverului

# ID-ul tau de Discord (click dreapta pe tine -> Copiaza ID-ul utilizatorului).
# Are acces la /setup si la comenzile periculoase indiferent de roluri.
OWNER_ID=id_ul_tau

# Prefixul canalelor si numele squad-ului (optional, se pot schimba)
SQUAD_NAME=Blood×Diamonds
SQUAD_TAG=BxD
