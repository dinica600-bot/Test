# ==========================================================
#  BLOOD×DIAMONDS — configurare bot
#  Copiază fișierul ăsta în ".env" și completează valorile.
# ==========================================================

# Tokenul botului (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=token_ul_tau_aici

# Application ID / Client ID (Developer Portal -> General Information)
CLIENT_ID=id_ul_aplicatiei

# ID-ul serverului tau (Discord -> Setari -> Avansat -> Mod dezvoltator, apoi
# click dreapta pe server -> Copiaza ID-ul server). Comenzile se inregistreaza
# instant pe serverul asta.
GUILD_ID=id_ul_serverului

# ID-ul tau de Discord (click dreapta pe tine -> Copiaza ID-ul utilizatorului).
# Are acces la /setup si la comenzile periculoase indiferent de roluri.
OWNER_ID=id_ul_tau

# Prefixul canalelor si numele squad-ului (optional, se pot schimba)
SQUAD_NAME=Blood×Diamonds
SQUAD_TAG=BxD

# ----------------------------------------------------------
#  Verificarea contului de Mobile Legends (optional)
# ----------------------------------------------------------
# Moonton nu are API public de statistici. Ce se poate verifica automat e
# NUMELE DIN JOC pe baza de User ID + Zone ID, prin serviciul folosit de
# site-urile de top-up. Daca serviciul de mai jos cade, pui altul aici —
# botul inlocuieste {id} si {server} in URL si cauta numele in raspuns.
MLBB_NICKNAME_API=https://api.isan.eu.org/nickname/ml?id={id}&server={server}

# Daca gasesti vreodata un serviciu care da si statistici (winrate, puncte),
# pune-l aici si botul le preia automat la /profil conecteaza. Lasa gol daca nu.
MLBB_STATS_API=

# ----------------------------------------------------------
#  Raspunsuri prin AI (optional)
# ----------------------------------------------------------
# Fara cheia asta, personajele raspund pe baza de reguli — gratis si fara
# internet in plus. Cu ea, intrebarile pe care regulile nu le prind exact
# ajung la Claude, care raspunde in numele personajului.
#
# Cheia se ia de pe console.anthropic.com. Cost orientativ: ~0,5 centi per
# raspuns, deci ~1 dolar la vreo 200 de raspunsuri.
ANTHROPIC_API_KEY=

# Modelul folosit si limita de raspunsuri pe ora (protectie pentru buget).
AI_MODEL=claude-opus-5
AI_MAX_PER_HOUR=40
